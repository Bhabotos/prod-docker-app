# Production environment template.
#
# On the server, copy this to .env (NOT committed to git - lives only on
# the server), set `chmod 600 .env`, and fill in real values. Generate strong
# passwords, e.g.:
#   openssl rand -base64 24

# --- App ---
APP_NAME=prod-docker-app
APP_ENV=production
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- pgAdmin (only reachable via 127.0.0.1 — see DEPLOYMENT.md) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-to-a-strong-random-value
PGADMIN_PORT=5050

# --- Nginx ---
NGINX_PORT=80

# --- Domain / SSL ---
# API_DOMAIN must already have a DNS A record pointing at this server before
# running scripts/init_ssl.sh. deploy.sh uses it for the post-deploy check.
API_DOMAIN=api.bhabotos.com
LETSENCRYPT_EMAIL=you@example.com

# --- Deployed images ---
# Written automatically by scripts/deploy.sh on every deploy (the pipeline
# passes the exact sha-tagged images). These defaults only matter for a manual
# `docker compose up` on the server.
FASTAPI_IMAGE=ghcr.io/OWNER/prod-docker-app-fastapi:latest
FRONTEND_IMAGE=ghcr.io/OWNER/prod-docker-app-frontend:latest

# --- BMI & Health Dashboard ---
# Least-privilege DB role, created ONCE with:  ./scripts/provision_bmi_db.sh --apply
#   BMI_DB_PASSWORD: openssl rand -hex 24   (hex only: it is embedded in a connection URL)
BMI_DB_USER=bmi_app
BMI_DB_PASSWORD=change-me-to-a-strong-random-value
# Both lines are printed by:  docker compose ... run --rm --no-deps fastapi python -m bmi_dashboard.cli hash-password
# The hash contains no "$", so Compose does not try to interpolate it. Leave empty to keep the feature disabled.
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
COOKIE_SECURE=true
