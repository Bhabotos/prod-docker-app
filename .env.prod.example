# Production environment template.
#
# On the server, copy this to .env (NOT committed to git — lives only on
# the server) and fill in real values. Generate strong passwords, e.g.:
#   openssl rand -base64 24

# --- App ---
APP_NAME=prod-docker-app
APP_ENV=production
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- pgAdmin (only reachable via 127.0.0.1 — see DEPLOYMENT.md) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-to-a-strong-random-value
PGADMIN_PORT=5050

# --- Nginx ---
NGINX_PORT=80

# --- Domain / SSL ---
# Must already point at this server's IP before running scripts/init_ssl.sh
DOMAIN_NAME=example.com
LETSENCRYPT_EMAIL=you@example.com

# --- Deployed image ---
# Set automatically by the CD workflow on each deploy; this default is only
# used if you run docker compose manually on the server.
FASTAPI_IMAGE=ghcr.io/OWNER/prod-docker-app-fastapi:latest
