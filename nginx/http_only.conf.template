# Phase 1 of scripts/init_ssl.sh: used BEFORE a certificate exists.
# Serves the Let's Encrypt HTTP-01 challenge and the app over plain HTTP.
# __DOMAIN_NAME__ is substituted by sed.
server {
    listen 80;
    server_name __DOMAIN_NAME__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    include /etc/nginx/snippets/app_locations.conf;
}
