# Phase 2 of scripts/init_ssl.sh: used AFTER the certificate exists.
# HTTP -> HTTPS redirect, TLS termination, then the shared app routing.
# __DOMAIN_NAME__ is substituted by sed.
server {
    listen 80;
    server_name __DOMAIN_NAME__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN_NAME__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/snippets/app_locations.conf;
}
