# Local development / CI. Copy to .env and fill in real values.
# NEVER commit the real .env file (it is gitignored).

# --- App ---
APP_NAME=prod-docker-app
APP_ENV=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- pgAdmin (bound to 127.0.0.1 only) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- Nginx ---
NGINX_PORT=80
